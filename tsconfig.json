{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "electron.vite.config.ts"],
  // The SCGC gateway tests run under their own NodeNext config and the
  // node:test runner (see test/scgc-gateway/ and the scgc-gateway-tests
  // workflow); they are not part of the app typecheck.
  "exclude": ["test/scgc-gateway"]
}
