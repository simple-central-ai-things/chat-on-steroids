#!/bin/sh
# SCGC xstartup — the desktop session for display :1, run by entrypoint.sh as
# PID 1 (Xvnc is already up).
#
# Order matters:
#   1. a private dbus session for this display — dbus-run-session owns the bus
#      for the app's lifetime (dbus-launch --exit-with-session dropped the bus
#      across the exec chain);
#   2. gnome-keyring seeded/unlocked NON-interactively from the passphrase
#      file, before Electron starts (the --login/--unlock form pops a GUI
#      "choose keyring password" dialog on first run and stalls the session);
#   3. openbox as the window manager;
#   4. the CoS build as the session leader with --no-sandbox (the container is
#      the security boundary; Chromium's setuid sandbox is unusable here).
#      When it exits, xstartup ends, the container stops and compose restarts.

export XDG_SESSION_TYPE=x11
export NO_AT_BRIDGE=1

dbus-run-session -- sh -c "
  head -c 255 /home/cos/keyring-passphrase 2>/dev/null | \
    gnome-keyring-daemon --daemonize --unlock >/dev/null 2>&1 || true
  sleep 1
  openbox >>/home/cos/cos-logs/openbox.log 2>&1 &
  # Browser watchdog: 30s state logging, 4h Firefox refresh. Its own loop,
  # so a crash here cannot take the desktop session down with it.
  nohup sh /home/cos/browser-watch.sh >>/home/cos/cos-logs/browser-watch.log 2>&1 &
  cd /home/cos/chat-on-steroids || exit 1
  # Launch the app DIRECTORY, not the entry file: that makes app.getAppPath()
  # the repo root, so CoS's locator finds the bundled tunnel-client at
  # resources/tunnel/ (where the npm tunnel script stages it). Passing the
  # bare entry path would root the app at out/main/ and shadow that directory.
  # No backticks or dollar signs in this comment: the whole block sits inside
  # double quotes of the sh -c string, where they would run as substitutions.
  exec ./node_modules/electron/dist/electron --no-sandbox .
" >>/home/cos/cos-logs/cos.log 2>&1
