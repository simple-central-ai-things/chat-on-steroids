# Template for the gateway.env file referenced by docker-compose.yml (env_file).
# Copy to gateway.env, set a real key, and never commit it.

# Bearer key required on every /v1/* call. With it unset the server still
# starts but refuses /v1/* with 503 (fail-closed).
GATEWAY_API_KEY=change-me

# Listen port for the in-process gateway (VNC uses 5901 inside the container).
PORT=8793

# Seconds before a turn is answered 504. The turn keeps running in CoS; a later
# request re-attaches to it by input id instead of double-sending.
TURN_TIMEOUT_SECONDS=600

# Include the OpenAI system message as a [Context for this conversation] prefix
# on a new chat's first turn (1 = on, 0 = off). Default: on.
GATEWAY_INCLUDE_SYSTEM=1
